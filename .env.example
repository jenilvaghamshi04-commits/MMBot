# Set in Render Environment. Never commit actual credentials.
LIVE_ADMIN_TOKEN=replace-with-a-random-operator-token-at-least-16-characters
LIVE_TRADING_ENABLED=false
# Stable ownership tag: use only one worker/account per tag.
GATE_BOT_TAG=lfmm
# Gate key and secret are entered through /live and kept in server memory only.

# Required before live access is enabled; configure Cloudflare Access first.
CF_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
CF_ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUDIENCE
CF_ACCESS_ALLOWED_EMAILS=operator@example.com
# Optional: private Telegram alert destination (never commit actual credentials).
SECURITY_ALERT_BOT_TOKEN=
SECURITY_ALERT_CHAT_ID=
